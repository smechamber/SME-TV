generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  phone           String?             @unique
  passwordHash    String?
  role            UserRole            @default(USER)
  status          AccountStatus       @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  articles        Article[]
  videos          Video[]
  eventRegistrations EventRegistration[]
  sessions        Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  articles  Article[]
  videos    Video[]
}

model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  summary     String
  content     String          @db.Text
  imageUrl    String?
  status      ContentStatus   @default(DRAFT)
  isFeatured  Boolean         @default(false)
  isBreaking  Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  authorId    String?
  categoryId  String?
  tags        String[]        @default([])
  author      User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
}

model Advertiser {
  id          String       @id @default(cuid())
  companyName String
  contactName String?
  email       String?
  phone       String?
  website     String?
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaigns   AdCampaign[]
  events      AdEvent[]
  @@index([companyName])
}

model AdCampaign {
  id          String       @id @default(cuid())
  advertiserId String
  name        String
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  advertiser  Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Restrict)
  creatives   AdCreative[]
  placements  AdPlacement[]
  events      AdEvent[]
  @@index([status, startsAt, endsAt])
  @@index([advertiserId, createdAt])
}

model AdCreative {
  id          String       @id @default(cuid())
  campaignId  String
  name        String
  mediaType   AdMediaType
  desktopUrl  String?
  tabletUrl   String?
  mobileUrl   String?
  clickUrl    String
  altText     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  campaign    AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placements  AdPlacement[]
  events      AdEvent[]
  @@index([campaignId, createdAt])
}

model AdPlacement {
  id                   String       @id @default(cuid())
  campaignId           String
  creativeId           String
  slot                 AdSlot
  targetArticleIds     String[]     @default([])
  targetCategoryIds    String[]     @default([])
  targetTags           String[]     @default([])
  excludedArticleIds   String[]     @default([])
  defaultForOtherArticles Boolean   @default(false)
  enabled              Boolean      @default(true)
  priority             Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  campaign             AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative             AdCreative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  events               AdEvent[]
  @@index([slot, enabled, priority])
  @@index([campaignId, slot])
}

model AdEvent {
  id            String       @id @default(cuid())
  advertiserId  String
  campaignId    String
  creativeId    String
  placementId   String
  eventType     AdEventType
  slot          AdSlot
  articleId     String?
  device        AdDevice     @default(DESKTOP)
  createdAt     DateTime     @default(now())
  advertiser    Advertiser  @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaign      AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative      AdCreative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placement     AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  @@index([eventType, createdAt])
  @@index([campaignId, createdAt])
  @@index([advertiserId, createdAt])
  @@index([slot, createdAt])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  videoType   VideoType     @default(UPLOAD)
  videoUrl    String?
  youtubeId   String?
  thumbnail   String?
  status      ContentStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  authorId    String?
  categoryId  String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([status, publishedAt])
}

model Event {
  id                String        @id @default(cuid())
  title             String
  eventType         String?
  slug              String        @unique
  description       String        @db.Text
  imageUrl          String?
  clickUrl          String?
  startsAt          DateTime
  endsAt            DateTime?
  location          String?
  status            EventStatus   @default(DRAFT)
  registrationClose DateTime?
  capacity          Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  registrations     EventRegistration[]
  @@index([status, startsAt])
}

model EventRegistration {
  id              String   @id @default(cuid())
  name            String
  designation     String
  companyName     String
  businessActivity String
  specificInterest String
  email           String
  mobile          String
  city            String
  state           String
  consent         Boolean  @default(false)
  createdAt       DateTime @default(now())
  eventId         String
  userId          String?
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@unique([eventId, email])
  @@index([eventId, createdAt])
}

model HomepageSection {
  id            String               @id @default(cuid())
  name          String
  kind          HomepageSectionKind  @default(CUSTOM)
  layout        HomepageLayout       @default(GRID)
  design        HomepageDesign       @default(STANDARD)
  source        HomepageSource       @default(MANUAL)
  contentType   HomepageContentType  @default(ARTICLE)
  itemCount     Int                  @default(6)
  contentIds    String[]
  displayFields String[]
  displayOrder  Int                  @default(0)
  enabled       Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([enabled, displayOrder])
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum VideoType {
  UPLOAD
  YOUTUBE
}
enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  POSTPONED
  CANCELLED
}
enum HomepageSectionKind {
  HERO
  TRENDING
  LATEST
  INTERVIEWS
  NEWS
  VIDEOS
  EVENTS
  CUSTOM
}
enum HomepageLayout {
  HERO
  GRID
  LIST
  CAROUSEL
}
enum HomepageDesign {
  STANDARD
  FEATURED_GRID
  SPLIT_FEATURED
  DARK_BAND
  COMPACT_LIST
  EVENT_CARDS
}
enum HomepageSource {
  MANUAL
  LATEST
  TRENDING
}
enum HomepageContentType {
  ARTICLE
  VIDEO
  EVENT
  MIXED
}
enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}
enum AdMediaType {
  IMAGE
  VIDEO
}
enum AdSlot {
  HOMEPAGE_TOP
  HOMEPAGE_MIDDLE
  ARTICLE_TOP
  ARTICLE_MIDDLE
  ARTICLE_BOTTOM
  SIDEBAR
  FOOTER
  NEWS_LIST_TOP
  VIDEO_LIST_TOP
}
enum AdEventType {
  IMPRESSION
  CLICK
}
enum AdDevice {
  DESKTOP
  TABLET
  MOBILE
}
