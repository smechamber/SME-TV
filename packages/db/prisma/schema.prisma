generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id              String              @id @default(cuid())
  name            String
  email           String              @unique
  phone           String?             @unique
  passwordHash    String?
  role            UserRole            @default(USER)
  status          AccountStatus       @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  articles        Article[]
  videos          Video[]
  eventRegistrations EventRegistration[]
  sessions        Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  articles  Article[]
  videos    Video[]
}

model Article {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  summary     String
  content     String          @db.Text
  imageUrl    String?
  status      ContentStatus   @default(DRAFT)
  isFeatured  Boolean         @default(false)
  isBreaking  Boolean         @default(false)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  authorId    String?
  categoryId  String?
  tags        String[]        @default([])
  author      User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  advertisementTargets AdvertisementArticle[]
  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
}

model Advertisement {
  id                String                @id @default(cuid())
  name              String
  imageUrl          String
  redirectUrl       String
  enabled           Boolean               @default(true)
  locations         AdSlot[]              @default([])
  articleTargetMode ContentTargetMode     @default(ALL)
  videoTargetMode   ContentTargetMode     @default(ALL)
  sidebarPosition   AdSidebarPosition     @default(BOTH)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  articles          AdvertisementArticle[]
  videos            AdvertisementVideo[]
  @@index([enabled, createdAt])
}

model AdvertisementArticle {
  advertisementId String
  articleId       String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  article         Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@id([advertisementId, articleId])
  @@index([articleId])
}

model AdvertisementVideo {
  advertisementId String
  videoId         String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  video           Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@id([advertisementId, videoId])
  @@index([videoId])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?       @db.Text
  videoType   VideoType     @default(UPLOAD)
  videoUrl    String?
  youtubeId   String?
  thumbnail   String?
  status      ContentStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  authorId    String?
  categoryId  String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  advertisementTargets AdvertisementVideo[]
  @@index([status, publishedAt])
}

model Event {
  id                String        @id @default(cuid())
  title             String
  eventType         String?
  slug              String        @unique
  description       String        @db.Text
  imageUrl          String?
  clickUrl          String?
  startsAt          DateTime
  endsAt            DateTime?
  location          String?
  status            EventStatus   @default(DRAFT)
  registrationClose DateTime?
  capacity          Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  registrations     EventRegistration[]
  @@index([status, startsAt])
}

model EventRegistration {
  id              String   @id @default(cuid())
  name            String
  designation     String
  companyName     String
  businessActivity String
  specificInterest String
  email           String
  mobile          String
  city            String
  state           String
  consent         Boolean  @default(false)
  createdAt       DateTime @default(now())
  eventId         String
  userId          String?
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@unique([eventId, email])
  @@index([eventId, createdAt])
}

model HomepageSection {
  id            String               @id @default(cuid())
  name          String
  kind          HomepageSectionKind  @default(CUSTOM)
  layout        HomepageLayout       @default(GRID)
  design        HomepageDesign       @default(STANDARD)
  source        HomepageSource       @default(MANUAL)
  contentType   HomepageContentType  @default(ARTICLE)
  itemCount     Int                  @default(6)
  contentIds    String[]
  displayFields String[]
  displayOrder  Int                  @default(0)
  enabled       Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([enabled, displayOrder])
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum VideoType {
  UPLOAD
  YOUTUBE
}
enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  POSTPONED
  CANCELLED
}
enum HomepageSectionKind {
  HERO
  TRENDING
  LATEST
  INTERVIEWS
  NEWS
  VIDEOS
  EVENTS
  CUSTOM
}
enum HomepageLayout {
  HERO
  GRID
  LIST
  CAROUSEL
}
enum HomepageDesign {
  STANDARD
  FEATURED_GRID
  SPLIT_FEATURED
  DARK_BAND
  COMPACT_LIST
  EVENT_CARDS
}
enum HomepageSource {
  MANUAL
  LATEST
  TRENDING
}
enum HomepageContentType {
  ARTICLE
  VIDEO
  EVENT
  MIXED
}
enum AdSlot {
  HOMEPAGE_TOP
  HOMEPAGE_MIDDLE
  HOMEPAGE_BOTTOM
  ARTICLE_TOP
  ARTICLE_MIDDLE
  ARTICLE_BOTTOM
  ARTICLE_SIDEBAR
  VIDEO_TOP
  VIDEO_MIDDLE
  VIDEO_BOTTOM
  VIDEO_SIDEBAR
  FOOTER
  NEWS_LIST_TOP
  VIDEO_LIST_TOP
  NEWS_SEARCH_TOP
  NEWS_SEARCH_BOTTOM
  NEWS_EVENTS_TOP
  NEWS_EVENTS_BOTTOM
  NEWS_ARCHIVES_TOP
  NEWS_ARCHIVES_BOTTOM
  VIDEOS_SEARCH_TOP
  VIDEOS_SEARCH_BOTTOM
  VIDEOS_EVENTS_TOP
  VIDEOS_EVENTS_BOTTOM
  VIDEOS_ARCHIVES_TOP
  VIDEOS_ARCHIVES_BOTTOM
}
enum ContentTargetMode {
  ALL
  SELECTED
}
enum AdSidebarPosition {
  LEFT
  RIGHT
  BOTH
}
